#!/bin/bash
# IG Studio.app: starts the local server in the background and opens the browser.
# Stop it from Settings > Quit in the app. Logs: ~/.ig-studio/server.log
APP_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
SERVER="$APP_DIR/app/server.py"
LOG_DIR="$HOME/.ig-studio"
mkdir -p "$LOG_DIR" && chmod 700 "$LOG_DIR"

ok_python() {
  "$1" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' >/dev/null 2>&1
}
PY=""
for p in python3 /opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3; do
  if [ "$p" = "/usr/bin/python3" ] && ! xcode-select -p >/dev/null 2>&1; then continue; fi
  if command -v "$p" >/dev/null 2>&1 && ok_python "$p"; then PY="$(command -v "$p")"; break; fi
done

if [ -z "$PY" ]; then
  osascript -e 'set r to button returned of (display dialog "IG Studio needs Python 3.9 or newer.\n\nInstall it from python.org (or run: brew install python), then open IG Studio again." with title "IG Studio" buttons {"Close", "Open python.org"} default button 2 with icon caution)' \
            -e 'if r is "Open python.org" then open location "https://www.python.org/downloads/macos/"' >/dev/null 2>&1
  exit 1
fi
# Already running? Just reopen it in the browser. (Double-clicking again
# otherwise only brings the old Terminal window forward and nothing opens.)
RUNNING_URL="$("$PY" - "${IG_STUDIO_HOME:-$LOG_DIR}/lock.json" <<'PYEOF' 2>/dev/null
import json, os, socket, sys
try:
    d = json.load(open(sys.argv[1]))
    os.kill(int(d["pid"]), 0)
    socket.create_connection(("127.0.0.1", int(d["port"])), timeout=1).close()
    print("http://127.0.0.1:%d/#t=%s" % (int(d["port"]), d["token"]))
except Exception:
    pass
PYEOF
)"
if [ -n "$RUNNING_URL" ]; then
  open "$RUNNING_URL"
  exit 0
fi

if [ ! -f "$SERVER" ]; then
  osascript -e 'display dialog "IG Studio.app must stay in the IG Studio folder, next to the app folder." with title "IG Studio" buttons {"OK"} with icon stop' >/dev/null 2>&1
  exit 1
fi
cd "$APP_DIR" || exit 1

# macOS privacy protection: an unsigned app opened from Finder is not allowed
# to read Desktop, Documents or Downloads, and macOS does not ask. Terminal can
# ask for that permission, so if the files can't be read, hand over to the
# .command launcher in Terminal instead of failing silently.
if ! "$PY" -c 'import sys; open(sys.argv[1], "rb").read(1)' "$SERVER" >/dev/null 2>&1; then
  echo "$(date '+%F %T') files not readable from the app (macOS privacy); opening in Terminal" >> "$LOG_DIR/server.log"
  if [ -f "$APP_DIR/IG Studio.command" ]; then
    open -a Terminal "$APP_DIR/IG Studio.command" && exit 0
  fi
  osascript -e 'display dialog "macOS is blocking IG Studio from reading this folder.\n\nDouble-click \"IG Studio.command\" in the same folder instead, or move the IG Studio folder out of Desktop, Documents and Downloads (for example into your home folder)." with title "IG Studio" buttons {"OK"} with icon caution' >/dev/null 2>&1
  exit 1
fi

nohup "$PY" "$SERVER" >> "$LOG_DIR/server.log" 2>&1 &
exit 0
