#!/bin/bash
# IG Studio.app: starts the local server in the background and opens the browser.
# Stop it from Settings > Quit in the app. Logs: ~/.ig-studio/server.log
APP_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
SERVER="$APP_DIR/app/server.py"
LOG_DIR="$HOME/.ig-studio"
mkdir -p "$LOG_DIR" && chmod 700 "$LOG_DIR"

ok_python() {
  "$1" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' >/dev/null 2>&1
}
PY=""
for p in python3 /opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3; do
  if [ "$p" = "/usr/bin/python3" ] && ! xcode-select -p >/dev/null 2>&1; then continue; fi
  if command -v "$p" >/dev/null 2>&1 && ok_python "$p"; then PY="$(command -v "$p")"; break; fi
done

if [ -z "$PY" ]; then
  osascript -e 'set r to button returned of (display dialog "IG Studio needs Python 3.9 or newer.\n\nInstall it from python.org (or run: brew install python), then open IG Studio again." with title "IG Studio" buttons {"Close", "Open python.org"} default button 2 with icon caution)' \
            -e 'if r is "Open python.org" then open location "https://www.python.org/downloads/macos/"' >/dev/null 2>&1
  exit 1
fi
if [ ! -f "$SERVER" ]; then
  osascript -e 'display dialog "IG Studio.app must stay in the IG Studio folder, next to the app folder." with title "IG Studio" buttons {"OK"} with icon stop' >/dev/null 2>&1
  exit 1
fi
cd "$APP_DIR" || exit 1
nohup "$PY" "$SERVER" >> "$LOG_DIR/server.log" 2>&1 &
exit 0
